# Bazel build configuration for the pi-natives NAPI addon pipeline.
# Cross targets, ISA variants, and release codegen are encoded in the
# //:natives-* addon targets (bazel/defs.bzl transition), so a bare
# `bazel build //:natives-<target>` is always release-grade.

common --enable_platform_specific_config

# Hermetic-ish action env: no host env leaks into action keys. Build scripts
# that need host tools (cmake for audiopus_sys' bundled opus) get an explicit
# PATH through crate annotations in MODULE.bazel.
build --incompatible_strict_action_env

# NOTE: rust pipelined_compilation stays OFF: handing dependents rmeta-only
# crates breaks `rust_test(crate = ...)` harness compiles whose deps export
# macro_rules! ("can't find crate" at macro expansion).

# Keep rustc errors readable.
build --@rules_rust//rust/settings:error_format=human
# Generated toolchains carry target_settings requiring the nightly channel.
build --@rules_rust//rust/toolchain/channel=nightly


# --- Rust validation (replaces cargo clippy/nextest in CI) --------------------
# Mirrors cargo semantics: crates with `[lints] workspace = true` (pi-ast,
# pi-iso, pi-natives, pi-shell, pi-voice, pi-walker) get the strict workspace
# policy
# (clippy-strict; bazel/clippy.bazelrc is generated from Cargo.toml); everything
# else gets default clippy + -Dwarnings (clippy). pi-builtins allows every
# clippy group in its manifest (ported brush/uutils/jaq code) while keeping
# rustc warnings at zero; the aspect ignores Cargo `[lints]`, so clippy-ported
# re-states those allows on top of -Dwarnings.
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dwarnings
build:clippy-strict --config=clippy
build:clippy-ported --config=clippy
build:clippy-ported --@rules_rust//rust/settings:clippy_flag=-Aclippy::all
build:clippy-ported --@rules_rust//rust/settings:clippy_flag=-Aclippy::pedantic
build:clippy-ported --@rules_rust//rust/settings:clippy_flag=-Aclippy::nursery
build:clippy-ported --@rules_rust//rust/settings:clippy_flag=-Aclippy::cargo
build:clippy-ported --@rules_rust//rust/settings:clippy_flag=-Aunfulfilled_lint_expectations
import %workspace%/bazel/clippy.bazelrc
# rustfmt check via aspect, against the workspace rustfmt.toml.
build:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=+rustfmt_checks
build:rustfmt --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml
test --test_output=errors
test --test_summary=terse

# --- CI base -----------------------------------------------------------------
build:ci --curses=no --color=yes --show_timestamps
build:ci --announce_rc
build:ci --verbose_failures
# BuildBuddy metadata (buildbuddy.io/docs/guide-metadata): ROLE=CI marks the
# invocation as CI in the UI and enables CI-side features (commit status
# reporting); USER gives CI history one stable identity instead of per-pod
# usernames. Inert without --config=bes.
build:ci --build_metadata=ROLE=CI
build:ci --build_metadata=USER=elidebot
# Fail-fast inside one invocation; job-level matrix provides isolation.
build:ci --keep_going=false
# Reuse sandbox trees between actions: the zig/xwin toolchains stage ~10k-file
# input trees per action, and rebuilding+async-deleting them for thousands of
# actions exhausts file descriptors on the kata pods (EMFILE in unix_jni).
build:ci --reuse_sandbox_directories

# --- Remote cache ------------------------------------------------------------
# The bazel-remote endpoint is cluster-internal only; .github/actions/bazel-cache
# composes endpoint + credentials into an rc fragment on omp-kata pods.
# GitHub-hosted runners never use a remote cache (actions/cache-backed
# --disk_cache instead). These configs carry only the policy bits.
#
# cache-rw: trusted in-cluster writers (omp-kata pods).
build:cache-rw --remote_upload_local_results=true
build:cache-rw --remote_local_fallback
# cache-ro: read-only consumers (e.g. local dev via .bazelrc.user + VPN/tailnet).
build:cache-ro --remote_upload_local_results=false
build:cache-ro --remote_local_fallback
# Don't let a cache outage fail the build.
build:cache-rw --remote_retries=2
build:cache-ro --remote_retries=2
build:cache-rw --remote_timeout=60s
build:cache-ro --remote_timeout=60s

# --- BuildBuddy ----------------------------------------------------------------
# Auth rides on a `--remote_header=x-buildbuddy-api-key=…` line supplied
# outside the repo: `~/.bazelrc` or `.bazelrc.user` locally, and the composed
# rc fragment (BUILDBUDDY_API_KEY secret) in CI. Never commit the key.
#
# bes: Build Event Service only — streams invocations to the BuildBuddy UI.
# Cache-agnostic, so it composes with the kata cluster cache or a disk cache.
# Commit metadata (COMMIT_SHA / BRANCH_NAME / GIT_TREE_STATUS) rides on the
# workspace-status script per buildbuddy.io/docs/guide-metadata — rc files
# cannot command-substitute, so it can't be a --build_metadata flag here.
common:bes --bes_results_url=https://elide-dev.buildbuddy.io/invocation/
common:bes --bes_backend=grpcs://elide-dev.buildbuddy.io
common:bes --build_metadata=REPO_URL=https://github.com/elide-dev/aura.git
common:bes --workspace_status_command=bazel/workspace-status.sh
# Rich timing profiles in the BuildBuddy UI (per-action labels + outputs).
build:bes --noslim_profile
build:bes --experimental_profile_include_primary_output
build:bes --experimental_profile_include_target_label

# buildbuddy: BES + the BuildBuddy remote cache. cache-rw expands first so its
# conservative 60s remote timeout is overridden by the longer one below
# (BuildBuddy is an internet hop away and serves multi-MB action outputs).
common:buildbuddy --config=bes
common:buildbuddy --config=cache-rw
common:buildbuddy --remote_cache=grpcs://elide-dev.buildbuddy.io
common:buildbuddy --remote_cache_compression
common:buildbuddy --remote_timeout=10m
# Compress blobs above this size on the wire (zstd); tiny blobs aren't worth
# the codec round trip.
common:buildbuddy --experimental_remote_cache_compression_threshold=100
# Runfiles trees are only needed where actions execute; skip building the
# local symlink forests.
common:buildbuddy --nobuild_runfile_links
# Route repo-rule downloads (zig/LLVM/xwin/rustc archives, multi-GB) through
# the BuildBuddy CAS so ephemeral runners skip the upstream fetch — this
# replaces the retired actions/cache repository-cache archives in CI.
common:buildbuddy --experimental_remote_downloader=grpcs://remote.buildbuddy.io

# rbe: remote execution on the BuildBuddy executors, on top of the cache.
# The exec platform pins linux-amd64 + zig gnu.2.17 so cc/rust toolchain
# resolution on the workers matches local cross builds (see
# //bazel/platforms:rbe-linux-x64); all toolchains are hermetic downloads, so
# the workers need no preinstalled compilers. Higher --jobs suits remote
# fan-out; --remote_download_toplevel keeps worker outputs from flooding the
# local disk.
common:rbe --config=buildbuddy
common:rbe --remote_executor=grpcs://elide-dev.buildbuddy.io
common:rbe --host_platform=//bazel/platforms:rbe-linux-x64
common:rbe --extra_execution_platforms=//bazel/platforms:rbe-linux-x64
build:rbe --define=EXECUTOR=remote
build:rbe --jobs=50
# Build-without-the-bytes: builds materialize only top-level outputs (the
# .node addons the natives pipeline copies out of bazel-bin); test runs
# fetch nothing beyond logs/status — intermediate artifacts stay in the
# BuildBuddy CAS. test:rbe expands after build:rbe for test commands, so
# minimal wins there.
build:rbe --remote_download_toplevel
test:rbe --remote_download_minimal

# --- Local development ---------------------------------------------------------
# Optional user overrides (remote cache endpoint, disk cache, etc.).
try-import %workspace%/.bazelrc.user
